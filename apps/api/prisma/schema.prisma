generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SALES
  MANAGER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum LeadSource {
  website_form
  phone_inbound
  walk_in
}

enum PreferredContactMethod {
  email
  phone
  sms
}

enum LeadActivityType {
  system
  call
  email
  note
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String
  fullName     String
  role         UserRole       @default(SALES)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  activities   LeadActivity[]
  assignedLead Lead[]         @relation("AssignedSalesperson")
}

model Lead {
  id                     String                 @id @default(uuid()) @db.Uuid
  firstName              String
  lastName               String
  email                  String
  phone                  String?
  message                String?
  source                 LeadSource             @default(website_form)
  status                 LeadStatus             @default(NEW)
  preferredContactMethod PreferredContactMethod @default(email)
  assignedToId           String?                @db.Uuid
  assignedTo             User?                  @relation("AssignedSalesperson", fields: [assignedToId], references: [id], onDelete: SetNull)
  archivedAt             DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  followUpActivities     LeadActivity[]

  @@index([status])
  @@index([assignedToId])
  @@index([archivedAt])
  @@index([createdAt])
}

model LeadActivity {
  id         String           @id @default(uuid()) @db.Uuid
  leadId     String           @db.Uuid
  userId     String           @db.Uuid
  type       LeadActivityType
  title      String
  note       String
  happenedAt DateTime
  createdAt  DateTime         @default(now())
  lead       Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([leadId, happenedAt])
  @@index([userId])
}
